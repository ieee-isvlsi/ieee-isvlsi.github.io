{"id":213,"date":"2025-07-30T11:18:14","date_gmt":"2025-07-30T11:18:14","guid":{"rendered":"https:\/\/isvlsi.santechglobalusa.com\/?page_id=213"},"modified":"2026-05-08T06:23:41","modified_gmt":"2026-05-08T06:23:41","slug":"registration","status":"publish","type":"page","link":"https:\/\/isvlsi.santechglobalusa.com\/registration\/","title":{"rendered":"Registration"},"content":{"rendered":"\n<div class=\"wp-block-buttons is-content-justification-center is-layout-flex wp-container-core-buttons-is-layout-749adb30 wp-block-buttons-is-layout-flex\"><\/div>\n\n\n\n<style>\n:root{\n    --primary:#045cb4;\n    --secondary:#eef2ff;\n    --text:#1e293b;\n    --border:#045cb4;\n   \/*--border:#e2e8f0;*\/\n    --radius:16px;\n}\n\n.conf-section{\n    font-family:Arial, sans-serif;\n    max-width:1200px;\n    margin:auto;\n    padding:40px 20px;\n    color:var(--text);\n}\n\n.conf-hero{\n    background:linear-gradient(135deg,#4f46e5,#7c3aed);\n    color:white;\n    padding:50px 30px;\n    border-radius:var(--radius);\n    margin-bottom:40px;\n    text-align:center;\n}\n\n.conf-hero h1{\n    font-size:42px;\n    margin-bottom:10px;\n}\n\n.conf-hero p{\n    font-size:18px;\n    opacity:0.95;\n}\n\n.info-grid{\n    display:grid;\n    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));\n    gap:20px;\n    margin-bottom:40px;\n}\n\n.info-card{\n    background:white;\n    border:1px solid var(--border);\n    border-radius:var(--radius);\n    padding:25px;\n    box-shadow:0 4px 14px rgba(0,0,0,0.05);\n}\n\n.info-card h3{\n    margin-top:0;\n    color:var(--primary);\n}\n\n.notice{\n    background:#fef3c7;\n    border-left:5px solid #f59e0b;\n    padding:18px;\n    border-radius:10px;\n    margin:30px 0;\n}\n\n.table-wrap{\n    overflow-x:auto;\n    margin-top:20px;\n}\n\n.conf-table{\n    width:100%;\n    border-collapse:collapse;\n    background:white;\n    border-radius:var(--radius);\n   \n    box-shadow:0 4px 14px rgba(0,0,0,0.05);\n}\n\n.conf-table th{\n    background:var(--primary);\n    color:white;\n    padding:16px;\n    text-align:left;\n    border:1px solid rgba(255,255,255,0.15);\n}\n\n.conf-table td{\n    padding:16px;\n    border:1px solid var(--border);\n    vertical-align:middle;\n}\n\n.conf-table tr:nth-child(even){\n    background:#f8fafc;\n}\n\n.category-cell{\n    background:#eef2ff;\n    font-weight:bold;\n    color:var(--primary);\n    width:28%;\n}\n\n.section-title{\n    margin-top:50px;\n    margin-bottom:20px;\n    font-size:30px;\n    color:var(--primary);\n}\n\n.highlight{\n    color:#dc2626;\n    font-weight:bold;\n}\n\n.footer-note{\n    margin-top:30px;\n    padding:20px;\n    background:#f8fafc;\n    border-radius:12px;\n    border:1px solid var(--border);\n}\n\n.register-btn{\n    display:inline-block;\n    margin-top:20px;\n    background:white;\n    color:var(--primary);\n    padding:14px 28px;\n    border-radius:50px;\n    text-decoration:none;\n    font-weight:bold;\n    transition:0.3s;\n}\n\n.register-btn:hover{\n    transform:translateY(-2px);\n}\n\n@media(max-width:768px){\n\n    .conf-hero h1{\n        font-size:30px;\n    }\n\n    .conf-table{\n        min-width:700px;\n    }\n}\n<\/style>\n\n<div class=\"conf-section\">\n\n  <div class=\"info-grid\">\n\n        <div class=\"info-card\">\n            <h3>\ud83d\udcc5 Registration Deadlines<\/h3>\n            <p><strong>Author Registration:<\/strong> 20th May, 2026<\/p>\n            <p><strong>Early Bird Deadline:<\/strong> 20th May, 2026<\/p>\n        <\/div>\n<\/div>\n\n    <div class=\"info-grid\">\n\n       \n\n        <div class=\"info-card\">\n    <h3>\ud83d\udcc4 Author Information<\/h3>\n\n    <ul style=\"padding-left:18px; line-height:1.8; margin:0;\">\n\n        <li>\n            At least one author per paper must be registered as an AUTHOR at the full Member \/ Non-Member Registration Rate, regardless of whether or not they are students.\n        <\/li>\n\n        <li>\n            Each Author Registration is valid for ONE paper.\n        <\/li>\n\n        <li>\n            Only for Foreign Author, if necessary, up to 4 additional papers can be purchased per author registration for an additional fee of <strong>USD 550<\/strong> per paper.\n        <\/li>\n\n        <li>\n           If any author(s) in the accepted paper has  foreign affiliation, then Foreign registration will be applicable for that paper.\n        <\/li>\n\n        <li>\n            For Indian Author Registration, each paper must be registered separately.\n        <\/li>\n\n        <li>\n            If any of the co-authors other than the primary registrant will be presenting the paper, please fill out their name during registration, and these co-authors will be included in the conference registrant list.\n        <\/li>\n\n    <\/ul>\n\n    \n\n\n<\/div>\n\n       \n\n    <\/div>\n\n    <div class=\"notice\">\n        <strong>Important:<\/strong> 18% GST will be added to all  fees as per Government of India norms.\n    <\/div>\n\n    <h2 class=\"section-title\" id=\"registration-table\">\n        Full Conference Registration Types and Pricing\n    <\/h2>\n\n    <p>\n        Each accepted paper requires a full registration by 20th May, 2026\n    <\/p>\n\n    <p class=\"highlight\">\n        \n    <\/p>\n\n    <div class=\"table-wrap\">\n\n        <table class=\"conf-table\">\n\n            <thead>\n                <tr>\n                    <th>Category<\/th>\n                    <th>Type<\/th>\n                    <th>IEEE MEMBER<\/th>\n                    <th>IEEE NON-MEMBER<\/th>\n                <\/tr>\n            <\/thead>\n\n            <tbody>\n\n                <!-- Authors -->\n                <tr>\n                    <td rowspan=\"3\" class=\"category-cell\">\n                        Authors<br>\n                        <small>(Including students)<\/small>\n                    <\/td>\n\n                    <td>Foreign<\/td>\n                    <td>USD 700<\/td>\n                    <td>USD 840<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Industry\/Scientist<\/td>\n                    <td>INR 27,000<\/td>\n                    <td>INR 32,000<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>India Academia<\/td>\n                    <td>INR 20,000<\/td>\n                    <td>INR 24,000<\/td>\n                <\/tr>\n\n                <!-- Delegates -->\n                <tr>\n                    <td rowspan=\"6\" class=\"category-cell\">\n                        Delegates\n                    <\/td>\n\n                    <td>Foreign<\/td>\n                    <td>USD 350<\/td>\n                    <td>USD 420<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Foreign Student<\/td>\n                    <td>USD 250<\/td>\n                    <td>USD 300<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Life Member<\/td>\n                    <td>USD 250<\/td>\n                    <td>&#8212;<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Industry\/Scientist<\/td>\n                    <td>INR 20,000<\/td>\n                    <td>INR 24,000<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Indian Academia<\/td>\n                    <td>INR 15,000<\/td>\n                    <td>INR 18,000<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Indian Student<\/td>\n                    <td>INR 12,000<\/td>\n                    <td>INR 14,000<\/td>\n                <\/tr>\n\n            <\/tbody>\n\n        <\/table>\n\n    <\/div>\n\n    <p style=\"margin-top:15px;\">\n        * Early registration rates end 20th May, 2026\n    <\/p>\n\n    <h2 class=\"section-title\">Sessions and Additional Items<\/h2>\n\n    <div class=\"table-wrap\">\n\n        <table class=\"conf-table\">\n\n            <thead>\n                <tr>\n                    <th>Additional Papers<\/th>\n                    <th>Fee<\/th>\n                <\/tr>\n            <\/thead>\n\n            <tbody>\n                <tr>\n                    <td>1 (one) Additional Paper<\/td>\n                    <td>USD 550<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>2 (two) Additional Paper<\/td>\n                    <td>USD 1100<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>3 (Three) Additional Paper<\/td>\n                    <td>USD 1650<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>4 (Four) Additional Paper<\/td>\n                    <td>USD 2200<\/td>\n                <\/tr>\n\n                <tr>\n                    <td>Additional Page Fee<\/td>\n                    <td>USD 150\/each<\/td>\n                <\/tr>\n            <\/tbody>\n\n        <\/table>\n\n    <\/div>\n\n    <div style=\"\n        margin-top:18px;\n        padding:14px;\n        background:#eef4ff;\n        border-left:4px solid #045cb4;\n        border-radius:8px;\n        font-size:15px;\n    \">\n        For any query regarding registration, please contact\n        <strong>Dr. Chandan Giri<\/strong> at\n        <strong>isvlsiregistration2026@gmail.com<\/strong>.  <br> Author registrations are non-refundable.\n    <\/div>\n\n\n\n<\/div>\n\n\n\n<p><\/p>\n","protected":false},"excerpt":{"rendered":"<p>\ud83d\udcc5 Registration Deadlines Author Registration: 20th May, 2026 Early Bird Deadline: 20th May, 2026 \ud83d\udcc4 Author Information At least one [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"postBodyCss":"","postBodyMargin":[],"postBodyPadding":[],"postBodyBackground":{"backgroundType":"classic","gradient":""},"site-sidebar-layout":"default","site-content-layout":"","ast-site-content-layout":"default","site-content-style":"default","site-sidebar-style":"default","ast-global-header-display":""