{"id":2204,"date":"2026-05-31T10:15:38","date_gmt":"2026-05-31T10:15:38","guid":{"rendered":"https:\/\/isvlsi.santechglobalusa.com\/?page_id=2204"},"modified":"2026-05-31T10:15:56","modified_gmt":"2026-05-31T10:15:56","slug":"accomodation","status":"publish","type":"page","link":"https:\/\/isvlsi.santechglobalusa.com\/accomodation\/","title":{"rendered":"Accomodation"},"content":{"rendered":"\n<style>\n    .isvlsi-accommodation {\n        max-width: 1100px;\n        margin: 30px auto;\n        padding: 30px;\n        background: #ffffff;\n        border-radius: 12px;\n        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n        font-family: Arial, Helvetica, sans-serif;\n        color: #333;\n        line-height: 1.7;\n    }\n\n    .isvlsi-accommodation h2 {\n        color: #003366;\n        text-align: center;\n        margin-bottom: 25px;\n        border-bottom: 3px solid #0056b3;\n        padding-bottom: 12px;\n    }\n\n    .isvlsi-accommodation h3 {\n        color: #0056b3;\n        margin-top: 30px;\n        margin-bottom: 15px;\n    }\n\n    .venue-card {\n        background: #f8fbff;\n        border-left: 5px solid #0056b3;\n        padding: 20px;\n        border-radius: 8px;\n        margin-bottom: 25px;\n    }\n\n    .venue-card h4 {\n        margin-top: 0;\n        color: #003366;\n        font-size: 1.3rem;\n    }\n\n    .important-note {\n        background: #fff8e6;\n        border: 1px solid #f0d98c;\n        color: #7a5c00;\n        padding: 15px;\n        border-radius: 6px;\n        margin-top: 15px;\n        font-weight: 600;\n    }\n\n    .contact-info a {\n        color: #0056b3;\n        text-decoration: none;\n    }\n\n    .contact-info a:hover {\n        text-decoration: underline;\n    }\n\n    .table-container {\n        overflow-x: auto;\n        margin-top: 20px;\n    }\n\n    .hotel-table {\n        width: 100%;\n        border-collapse: collapse;\n        background: #fff;\n    }\n\n    .hotel-table thead {\n        background: #003366;\n        color: #fff;\n    }\n\n    .hotel-table th,\n    .hotel-table td {\n        padding: 14px 12px;\n        border: 1px solid #e0e0e0;\n        text-align: left;\n        vertical-align: top;\n    }\n\n    .hotel-table tbody tr:nth-child(even) {\n        background: #f8f9fb;\n    }\n\n    .hotel-table tbody tr:hover {\n        background: #eef5ff;\n    }\n\n    .hotel-table a {\n        color: #0056b3;\n        text-decoration: none;\n    }\n\n    .hotel-table a:hover {\n        text-decoration: underline;\n    }\n\n    @media (max-width: 768px) {\n        .isvlsi-accommodation {\n            padding: 20px;\n        }\n\n        .hotel-table th,\n        .hotel-table td {\n            padding: 10px;\n            font-size: 14px;\n        }\n    }\n<\/style>\n\n<div class=\"isvlsi-accommodation\">\n\n    <h2>Booking of Accommodation for ISVLSI 2026<\/h2>\n\n    <div class=\"venue-card\">\n        <h4>Venue Hotel: ITC Sonar Kolkata<\/h4>\n\n        <p>\n            <strong>Rate:<\/strong><br>\n            Single occupancy (CP): INR -12,000 + taxes<br>\n            Double occupancy (CP): INR -13,000 + taxes\n        <\/p>\n\n        <div class=\"contact-info\">\n            <p>\n                <strong>To book at this rate please mail to:<\/strong><br>\n                Ms. Srestha Chatterjee \u2014\n                <a href=\"mailto:Srestha.Chatterjee@itchotels.com\">Srestha.Chatterjee@itchotels.com<\/a><br>\n                <strong>CC:<\/strong>\n                <a href=\"mailto:sjd.subha@gmail.com\">sjd.subha@gmail.com<\/a>\n            <\/p>\n\n            <p>\n                <strong>Subject of mail should be:<\/strong> Booking for ISVLSI 2026\n            <\/p>\n        <\/div>\n\n        <div class=\"important-note\">\n            This rate is strictly on First Come First Serve basis.\n        <\/div>\n    <\/div>\n\n    <h3>Other Hotels within 10 km of ITC Royal Bengal, Kolkata<\/h3>\n\n    <div class=\"table-container\">\n        <table class=\"hotel-table