{"id":2128,"date":"2026-05-12T17:08:40","date_gmt":"2026-05-12T17:08:40","guid":{"rendered":"https:\/\/isvlsi.santechglobalusa.com\/?page_id=2128"},"modified":"2026-05-24T12:49:31","modified_gmt":"2026-05-24T12:49:31","slug":"research-forum","status":"publish","type":"page","link":"https:\/\/isvlsi.santechglobalusa.com\/research-forum\/","title":{"rendered":"Research Forum"},"content":{"rendered":"\n<section class=\"research-forum-section\">\n  <div class=\"rf-container\">\n\n    <h2 class=\"rf-title\">ISVLSI 2026 Research Forum<\/h2>\n\n    <p>\n      ISVLSI 2026 is pleased to announce the Research Forum as an integral component of this year\u2019s conference. \n      This forum is designed for doctoral researchers at an important stage in their careers, specifically those \n      within one year (before or after) of their PhD defense in VLSI and related fields. It offers a unique, \n      informal environment to engage with experts from both academia and industry, providing participants with \n      invaluable feedback and networking opportunities to advance their research.\n    <\/p>\n\n    <div class=\"rf-card\">\n      <h3>Deadlines<\/h3>\n\n      <div class=\"rf-deadline\">\n        <span>Call Opens:<\/span>\n        <strong>May 11, 2026<\/strong>\n      <\/div>\n\n      <div class=\"rf-deadline\">\n        <span>Last Date for Submission:<\/span>\n        <strong><strike>May 24, 2026<\/strike> May 31, 2026<\/strong>\n      <\/div>\n\n      <div class=\"rf-deadline\">\n        <span>Acceptance Notification:<\/span>\n        <strong>June 07, 2026<\/strong>\n      <\/div>\n    <\/div>\n\n    <div class=\"rf-card\">\n      <h3>Eligibility<\/h3>\n\n      <p>\n        <strong>Research Forum:<\/strong> This forum is open to researchers who are within one year of their PhD defense \n        (either one year prior to or following conferment). ISVLSI 2026 is pleased to offer waived registration and \n        awards for selected participants in this forum.\n      <\/p>\n    <\/div>\n\n    <div class=\"rf-card\">\n      <h3>Submission Process<\/h3>\n\n      <p>\n        Prospective participants are requested to provide their personal details (name, affiliation, and faculty advisor) \n        along with a list of peer-reviewed publications including DOIs and URLs. Additionally, applicants must submit \n        their thesis title, defense date, a link to the full thesis, and a two-page extended abstract. This abstract \n        should summarize the main contributions of the research, follow the templates provided below, and be submitted \n        in PDF format.\n      <\/p>\n\n      <p><strong>Research Forum Template<\/strong><\/p>\n\n      <div class=\"rf-btn-group\">\n        <a href=\"https:\/\/isvlsi.santechglobalusa.com\/wp-content\/uploads\/2026\/05\/ISVLSI26_ResearchForum_submission_template.pdf\" class=\"rf-btn\">Download Template<\/a>\n        <a href=\"https:\/\/easychair.org\/conferences\/?conf=isvlsi2026\" class=\"rf-btn rf-btn-outline\">Submission Link<\/a>\n      <\/div>\n    <\/div>\n\n    <div class=\"rf-card\">\n      <h3>Selection Criteria<\/h3>\n\n      <p>\n        Submissions to the Research Forum Track will be evaluated based on the quality of the research, its relevance \n        to the ISVLSI conference, and the candidate\u2019s academic accomplishments and publication record in journals and \n        international conferences. Please note that accepted extended abstracts will not be published in the conference proceedings.\n      <\/p>\n    <\/div>\n\n    <div class=\"rf-card\">\n      <h3>Participation<\/h3>\n\n      <p>\n        Registration fees will be waived for selected candidates, and accommodation may be arranged upon request.\n      <\/p>\n\n      <p>\n        Participants in the Research Forum must provide proof of research scholar status, and proof of thesis defense upon acceptance.\n      <\/p>\n    <\/div>\n\n    <div class=\"rf-card\">\n      <h3>Presentation<\/h3>\n\n      <p>\n        Participants in the Research Forum will present their work via 5-minute talks, followed by an interactive \n        poster session. Outstanding PhD contributions will be recognized with awards and certificates, along with \n        the unique opportunity to pursue industry-sponsored projects or co-mentorship from leading experts. The best \n        presentation will be recognized with the \u201cBest PhD Poster\u201d award, as decided by the committee.\n      <\/p>\n\n      <p>\n        Certificates of participation will be awarded at the end of the conference.\n      <\/p>\n    <\/div>\n\n  <\/div>\n<div style=\"text-align:center; padding:30px; font-size:20px; line-height:1.8; font-family:Arial, sans-serif;\">\n    <strong>For any queries please write to this email:<\/strong><br>\n    <a href=\"mailto:isvlsiresearchforum@gmail.com\" style=\"color:#0073aa; text-decoration:none; font-weight:bold;\">\n       isvlsiresearchforum@gmail.com\n    <\/a>\n<\/div>\n<\/section>\n\n\n<style>\n.research-forum-section{\n    padding:40px 20px;\n    background:#f5f7fb;\n    font-family:Arial, sans-serif;\n}\n\n.rf-container{\n    max-width:1100px;\n    margin:auto;\n}\n\n.rf-title{\n    font-size:38px;\n    font-weight:700;\n    color:#0b1f3a;\n    margin-bottom:25px;\n    text-align:center;\n}\n\n.rf-card{\n    background:#fff;\n    padding:25px;\n    margin-top:25px;\n    border-radius:14px;\n    box-shadow:0 4px 15px rgba(0,0,0,0.06);\n}\n\n.rf-card h3{\n    margin-top:0;\n    margin-bottom:18px;\n    color:#123b75;\n    font-size:24px;\n    border-left:5px solid #1d4ed8;\n    padding-left:12px;\n}\n\n.rf-card p{\n    line-height:1.8;\n    color:#333;\n    margin-bottom:15px;\n}\n\n.rf-deadline{\n    display:flex;\n    justify-content:space-between;\n    padding:12px 0;\n    border-bottom:1px solid #e5e7eb;\n    font-size:16px;\n}\n\n.rf-deadline:last-child{\n    border-bottom:none;\n}\n\n.rf-btn-group{\n    margin-top:20px;\n    display:flex;\n    gap:15px;\n    flex-wrap:wrap;\n}\n\n.rf-btn{\n    display:inline-block;\n    padding:12px 22px;\n    background:#1d4ed8;\n    color:#fff;\n    text-decoration:none;\n    border-radius:8px;\n    font-weight:600;\n    transition:0.3s;\n}\n\n.rf-btn:hover{\n    background:#163ea8;\n}\n\n.rf-btn-outline{\n    background:#fff;\n    color:#1d4ed8;\n    border:2px solid #1d4ed8;\n}\n\n.rf-btn-outline:hover{\n    background:#1d4ed8;\n    color:#fff;\n}\n\n@media(max-width:768px){\n\n    .rf-title{\n        font-size:28px;\n    }\n\n    .rf-deadline{\n        flex-direction:column;\n        gap:5px;\n    }\n\n    .rf-card{\n        padding:20px;\n    }\n}\n<\/style>\n","protected":false},"excerpt":{"rendered":"<p>ISVLSI 2026 Research Forum ISVLSI 2026 is pleased to announce the Research Forum as an integral component of this year\u2019s [&hellip;]<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"postBodyCss":"","postBodyMargin":[],"postBodyPadding":[],"postBodyBackground":{"backgroundType":"classic","gradient":""},"site-sidebar-layout":"default","site-content-layout":"","ast-site-content-layout":"default","site-content-style":"default","site-sidebar-style":"default","ast-global-header-display":"","ast-banner-title-visibility":"","ast-main-header-display":"","ast-hfb-above-header-display":"","ast-hfb-below-header-display":"","ast-hfb-mobile-header-display":"","site-post-title":"disabled","ast-breadcrumbs-content":"","ast-featured-img":"","footer-sml-layout":"","theme-transparent-header-meta":"","adv-header-id-meta":"","stick-header-meta":"","header-above-stick-meta":"","header-main-stick-meta":"","header-below-stick-meta":"","astra-migrate-meta-layouts":"default","ast-page-background-enabled":"default","ast-page-background-meta":{"desktop":{"background-color":"var(--ast-global-color-5)","background-image":"","background-repeat":"repeat","background-position":"center center","background-size":"auto","backgroun